{
  // Commit without staging first: the Commit button acts on all changes.
  "git.enableSmartCommit": true,
  "git.suggestSmartCommit": false,

  // Push automatically after each commit, so committing really does sync.
  // Remove this line if you would rather push by hand.
  "git.postCommitCommand": "push",

  // Notice the other machine's work without asking for it.
  "git.autofetch": true,
  "git.fetchOnPull": true,
  "git.pruneOnFetch": true,
  "git.confirmSync": false,

  // Generated by scripts/build.sh. Editing them by hand is always a mistake -
  // the next build overwrites it, and hand-merging them across two machines is
  // miserable. Marked read-only so the editor refuses.
  "files.readonlyInclude": {
    "js/main.js": true,
    "css/style.css": true,
    "quick.html": true
  },

  // Vendored reference material and generated bundles drown out real results.
  "search.exclude": {
    "Ref/**": true,
    "after-effects-scripting-guide-master/**": true,
    "AEGP/**": true,
    "js/main.js": true,
    "css/style.css": true,
    "quick.html": true
  },

  "files.eol": "\n",
  "files.trimTrailingWhitespace": true
}
