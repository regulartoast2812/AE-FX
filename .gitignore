# This repo is the deployment unit: After Effects loads the extension straight
# out of this folder, and it gets copied to other machines as-is. So the built
# bundles (js/main.js, css/style.css, quick.html) ARE tracked - a clone has to be
# runnable on a machine with no bash to run scripts/build.sh.
#
# Only genuinely per-machine, per-platform build output is ignored below.

# Compiled native helpers - rebuilt per platform, never shared between them
native/*.app/
native-helper/.build/
native-helper-win/bin/
native-helper-win/obj/

# Packaged extension output
*.zxp

# Dependencies
node_modules/

# Logs and scratch
*.log
*.tmp
*.bak
*~
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
